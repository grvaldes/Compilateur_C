digraph Automaton {
  rankdir=LR;
  node [shape=circle];
  q0 [shape=doublecircle];
  q1;
  q2;
  q3;
  start_q1 [shape=point];
  start_q1 -> q1;
  q1 -> q1 [label="a"];
  q1 -> q3 [label="b"];
  q3 -> q2 [label="a"];
  q3 -> q3 [label="b"];
  q2 -> q1 [label="a"];
  q2 -> q0 [label="b"];
  q0 -> q2 [label="a"];
  q0 -> q3 [label="b"];
}
